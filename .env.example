# VFS Global account credentials
VFS_EMAIL=your_email@example.com
VFS_PASSWORD=your_password

# IMAP credentials for reading the OTP email (use an app password, not your real password)
IMAP_USERNAME=your_email@gmail.com
IMAP_PASSWORD=your_app_password

# Telegram notifications
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenHere
# Optional: your chat ID so you get notifications without /start.
# Others subscribe by sending /start to the bot.
TELEGRAM_CHAT_ID=

# Optional proxy (recommended: residential proxy to bypass Cloudflare).
# The server can also be set in config.yaml under proxy.server.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
